# CRT Trading System - Local Environment Configuration Template
# Copy this file to .env:
#   cp .env.example .env
# Never commit .env to git (it is included in .gitignore).

# Deployment mode: 0 for localhost-only (default), 1 for public Render deployment
DASHBOARD_PUBLIC=0

# Server network binding: must be 127.0.0.1 or localhost when DASHBOARD_PUBLIC=0
HOST=127.0.0.1
PORT=8000

# Delta Exchange Environment: india_testnet or india_prod
DELTA_MCP_ENV=india_testnet

# Live order execution gate: 0 to disable live order submission (DEFAULT), 1 to enable
# ALWAYS keep at 0 until testnet validation is complete!
CRT_LIVE_ENABLED=0

# Delta Exchange API credentials (from https://testnet.delta.exchange or https://india.delta.exchange)
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Directory where SQLite state, locks, and intent ledgers are persisted
CRT_STATE_DIR=runtime/crt

# Optional Google OAuth settings (ONLY used when DASHBOARD_PUBLIC=1 on Render; ignore for localhost)
# DASHBOARD_SESSION_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_EMAIL=
